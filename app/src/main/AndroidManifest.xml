<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The app's own networking. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Push notification display on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:theme="@style/Theme.QDate.Splash">

        <!-- AdMob application ID (required — the app crashes without it). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-7363297117234770~1306337609" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|smallestScreenSize|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Continue with Google" hands the finished OAuth session back to the
                 WebView via this custom-scheme link, opened by the device browser. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="qdate" android:host="resume" />
            </intent-filter>
        </activity>

        <!-- FCM: receives push messages (data-only) from the PHP backend. -->
        <service
            android:name=".QDateMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.messaging.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Exposes the camera-capture cache dir so ACTION_IMAGE_CAPTURE / ACTION_VIDEO_CAPTURE
             can write their output straight into the app. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
